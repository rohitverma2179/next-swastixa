<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  Options -MultiViews
  DirectoryIndex index.html

  # 1. Serve existing files/directories directly (e.g., css, js, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. If a matching .html static file exists, serve it directly
  # (e.g., /about -> about.html, /services/content-marketing -> services/content-marketing.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*?)/?$ $1.html [L]

  # 3. Fallback to index.html for any remaining routes
  RewriteRule ^ index.html [L]
</IfModule>